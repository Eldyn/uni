{
  "id": "dice_roll",
  "title": "Dice Roll",
  "description": "acceptance: rolls the loot outcome table, binding $last_outcome for the dice entity's outcome.resolver. Gated by a condition that never matches shipped content, so it validates the roll_table -> $last_outcome wiring without changing live behaviour.",
  "hooks": [
    {
      "on": "after:play",
      "where": { "outcome_is": { "key": "never" } },
      "nodes": [
        {
          "id": "n1",
          "op": "roll_table",
          "args": { "table": "loot" },
          "next": "n2"
        },
        {
          "id": "n2",
          "cases": [
            { "when": { "outcome_is": { "key": "six" } }, "next": "n3" },
            { "when": { "outcome_is": { "key": "rare" } }, "next": "n3" }
          ],
          "else": "n3"
        },
        {
          "id": "n3",
          "op": "emit_signal",
          "args": { "name": "dice_rolled", "payload": { "source": "dice_roll" } }
        }
      ]
    }
  ]
}
