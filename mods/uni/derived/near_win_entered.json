    "uni:close_on": [
      { "uni:event": "card_played", "uni:seat_field": "player" },
      { "uni:event": "cards_drawn", "uni:seat_field": "target" },
      { "uni:event": "turn_skipped", "uni:seat_field": "target" },
      { "uni:event": "match_ended", "uni:seat_field": "target" }
    ]
  }
