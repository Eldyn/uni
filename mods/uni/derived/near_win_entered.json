    "uni:emits": "near_win_entered",
    "uni:open_on": [
      {
        "uni:event": "card_played",
        "uni:seat_field": "player",
        "uni:tests": [
          { "uni:test": "equals", "uni:state": "hand_size", "uni:value": 1 },
