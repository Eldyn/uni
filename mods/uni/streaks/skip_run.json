{
  "uni:format_version": "1.0.0",
  "uni:streak": {
    "uni:description": { "uni:identifier": "uni:skip_run" },
    "uni:type": "run",
    "uni:matcher": { "uni:event": "turn_skipped" },
    "uni:group_by": "target",
    "uni:reset_on": [
      { "uni:event": "cards_drawn" },
      { "uni:event": "drawn_card_kept" },
      { "uni:event": "direction_changed" },
      {
        "uni:event": "card_played",
        "uni:tests": [
          { "uni:test": "has_tag", "uni:tag": "uni:skip", "uni:negate": true }
        ]
      }
    ]
  }
}
