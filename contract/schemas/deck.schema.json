{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playuni.app/contract/schemas/deck.schema.json",
  "title": "Deck snapshot (decks/*.json)",
  "description": "A lobby-settings snapshot: mod list + card multiset + typed settings bag. Selecting a deck loads the whole snapshot at once.",
  "type": "object",
  "required": ["id", "name", "mods", "cards"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$",
      "description": "Owning mod id when the snapshot is shipped inside a mod folder."
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,32}$"
      }
    },
    "cards": {
      "type": "object",
      "description": "Kind id -> copy count multiset.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "propertyNames": {
        "pattern": "^[a-z0-9_]{1,32}:[a-z0-9_]{1,32}$"
      }
    },
    "settings": {
      "type": "object",
      "description": "Typed settings bag; values validate against mod-declared setting declarations."
    }
  }
}
