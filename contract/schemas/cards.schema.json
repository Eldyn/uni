{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playuni.app/contract/schemas/cards.schema.json",
  "title": "Card definition (cards/<local_id>.json)",
  "description": "One card definition per file (D1). Local id is unique within the mod; the full kind id is `namespace:id`.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "$ref": "#/$defs/localId"
    },
    "title": {
      "type": "string"
    },
    "face": {
      "$ref": "#/$defs/face"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behavior": {
      "$ref": "#/$defs/behavior"
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "auto_trigger": {
      "$ref": "#/$defs/autoTrigger"
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "face": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["text", "image", "emoji", "blank"]
        },
        "color": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "art": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,32}$",
          "description": "Asset bundle id the face references (D4); the face kind selects the slot."
        },
        "art_mode": {
          "type": "string",
          "enum": ["inset", "replace", "overlay"],
          "default": "inset",
          "description": "Layer composition (D6): inset draws art inside the vanilla frame, replace covers the whole card, overlay draws over the vanilla composite."
        },
        "art_fit": {
          "type": "string",
          "enum": ["contain", "cover", "stretch"],
          "default": "contain"
        },
        "keep": {
          "type": "array",
          "description": "Layers drawn over the art (defaults per art_mode).",
          "items": {
            "type": "string",
            "enum": ["value", "border"]
          }
        },
        "art_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Participates in the client face-hash; bump when art changes."
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "behaviorEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["before", "after"]
        },
        "where": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "graph": {
          "$ref": "#/$defs/graph"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/behaviorEntry"
      },
      "description": "Named trigger entries keyed by hook name (e.g. on_play)."
    },
    "window": {
      "type": "object",
      "required": ["when_played"],
      "additionalProperties": true,
      "properties": {
        "when_played": {
          "type": "object",
          "required": ["responders", "respond_with", "duration", "on_response", "default"],
          "additionalProperties": true,
          "properties": {
            "responders": {
              "type": "string"
            },
            "respond_with": {
              "type": "object"
            },
            "duration": {
              "type": "string"
            },
            "on_response": {
              "type": "string"
            },
            "default": {
              "type": "string"
            }
          }
        }
      }
    },
    "autoTrigger": {
      "type": "object",
      "required": ["condition", "graph"],
      "additionalProperties": true,
      "properties": {
        "condition": {
          "type": "object"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "must_apply": {
          "type": "boolean",
          "default": false,
          "description": "true = fires without player agency."
        }
      }
    }
  }
}
